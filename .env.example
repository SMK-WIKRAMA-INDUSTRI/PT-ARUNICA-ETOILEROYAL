# ── Server only (never prefix these with VITE_) ──────────────────────────────
# Provider key, kept out of the browser bundle. Start with `npm run dev`.
DEEPSEEK_API_KEY=your_api_key_here
# Either a base URL (native DeepSeek) or the full completions endpoint (gateways like Netra.sh).
# DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_BASE_URL=https://api.netra.sh/v1/chat/completions
DEEPSEEK_MODEL=deepseek/deepseek-v4.1-flash
PORT=8787

# ── Browser (a URL only — never put an API key here) ─────────────────────────
# Contract: POST { lang, currency, messages: [{ role, content }] }
#        -> { text, recommendedIds? }
VITE_CONCIERGE_PROXY_URL=http://localhost:8787/concierge

# Deepgram API key for voice input (stage 3). Read by the browser via envPrefix.
API_DIAGRAM_VOICE=your_deepgram_api_key_here
