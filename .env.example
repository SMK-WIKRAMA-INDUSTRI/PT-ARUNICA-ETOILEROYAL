# ── Server only (never prefix these with VITE_) ──────────────────────────────
# Masukkan API Key dari Google AI Studio (aistudio.google.com)
DEEPSEEK_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Gunakan OpenAI-compatible endpoint milik Google Gemini API
DEEPSEEK_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions

# Gunakan model Gemini yang tersedia di AI Studio (misal: gemini-2.5-flash atau gemini-2.5-pro)
DEEPSEEK_MODEL=gemini-2.5-flash

PORT=8787

# ── Browser (a URL only — never put an API key here) ─────────────────────────
VITE_CONCIERGE_PROXY_URL=http://localhost:8787/concierge

# Deepgram API key for voice input (stage 3). Read by the browser via envPrefix.
API_DIAGRAM_VOICE=your_deepgram_api_key_here

# ── Supabase (chat session persistence) ────────────────────────────────────────
# Create a project at https://supabase.com, run supabase/schema.sql in the SQL editor,
# then paste the Project URL and anon/public key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here